# =========================
# Outlook Mail Station 配置说明
# =========================
# 这是示例文件。复制为 `.env` 后再改成你自己的值。
#
# 哪些是必填：
# 1. 后台管理员登录：必须配置 `OUTLOOK_MAIL_STATION_ADMIN_PASSWORD`
# 2. 开放接口使用“用户级 API Key”，无需额外环境变量
# 3. 其他项都有默认值，不改也能跑


# =========================
# 数据库配置
# =========================
# 作用：指定 SQLite 数据库文件位置。
#
# Docker 部署：
# - 建议保持这一行不变
# - 容器内会写到 /app/data/outlook_mail_station.db
#
# 本机直接运行：
# - 也可以保持这一行不变
# - 程序会自动映射到当前项目目录下的 ./data/outlook_mail_station.db
#
# 如果你想自己指定本机路径，也可以改成：
# OUTLOOK_MAIL_STATION_DB=sqlite:///D:/your-path/outlook_mail_station.db
OUTLOOK_MAIL_STATION_DB=sqlite:////app/data/outlook_mail_station.db


# =========================
# 管理员后台登录
# =========================
# 作用：登录管理后台页面（不是开放接口）
#
# ADMIN_PASSWORD：
# - 后台登录密码
# - 访问 http://localhost:8015/login 时要输入这个
#
# ADMIN_JWT_SECRET：
# - 后台登录后生成 JWT 用的签名密钥
# - 建议改成一串足够长的随机字符串
# - 这是后台会话安全关键项，不要保留示例值
OUTLOOK_MAIL_STATION_ADMIN_PASSWORD=change-me
OUTLOOK_MAIL_STATION_ADMIN_JWT_SECRET=change-me-too


# =========================
# 开放接口认证
# =========================
# 作用：调用 /api/open/* 这类对外接口时做认证
#
# 当前版本改为“每个普通用户独立 API Key”模式：
# 1. 在后台“用户管理 -> 账户管理”中查看或重置该用户的 API Key
# 2. 调用 /api/open/* 时，传该用户自己的 Key 即可
# 3. 不再需要平台级固定 Key 环境变量


# =========================
# 开放接口与活跃邮箱同步
# =========================
# OPEN_API_SYNC_COOLDOWN_SECONDS：
# - 邮件内容不是每次 API 调用都强制重新拉取
# - 这里控制“同一个邮箱两次真实同步之间至少间隔多少秒”
# - 例如 60 表示 60 秒内重复请求会优先复用缓存
OUTLOOK_MAIL_STATION_OPEN_API_SYNC_COOLDOWN_SECONDS=60
#
# ACTIVE_MAILBOX_SYNC_INTERVAL_SECONDS：
# - 后台扫描“活跃邮箱”的频率
# - 活跃邮箱指已经通过开放接口分配给某个站点、但尚未释放的邮箱
OUTLOOK_MAIL_STATION_ACTIVE_MAILBOX_SYNC_INTERVAL_SECONDS=5
#
# ACTIVE_MAILBOX_SYNC_STALE_SECONDS：
# - 活跃邮箱距离上次同步超过多少秒后，后台才会再次预热
OUTLOOK_MAIL_STATION_ACTIVE_MAILBOX_SYNC_STALE_SECONDS=8
#
# ACTIVE_MAILBOX_SYNC_LIMIT：
# - 首次回填最近邮件时的上限
OUTLOOK_MAIL_STATION_ACTIVE_MAILBOX_SYNC_LIMIT=30


# =========================
# 前端页面自动刷新
# =========================
# 作用：控制后台页面上“几秒后自动刷新”的倒计时
# - 单位：秒
# - 只影响页面交互，不影响开放接口
OUTLOOK_MAIL_STATION_AUTO_REFRESH=10
